#!/usr/bin/env bash
# vac — VELLUR AI CORE control. Installed as /usr/local/bin/vac. Run with sudo.
#
#   vac status                       containers, health, memory, exposure, models
#   vac verify                       end-to-end checks (local + public)
#   vac logs [gateway|webui|gpu-tunnel] [-f]
#   vac start | stop | restart [service]       vac update (pull pinned versions)
#   vac keys list | add <name> | revoke <name>  gateway client keys (OpenCode, apps)
#   vac expose [--force] | unexpose  publish through Caddy / roll back (backup + validate + auto-restore)
#   vac gpu init                     create the SSH key + vLLM API key for the GPU workspace
#   vac gpu connect [<host>] <port>  point the tunnel at a running GPU workspace, then start it
#   vac gpu up | down | status | test
#   vac ui enable | disable          optional Open WebUI (~1 GB RAM)
#   vac backup | restore <file>
#
# Touches only: the vellur-ai-core compose project and volume, /etc/caddy/vellur-ai-core.caddy,
# ONE import line in /etc/caddy/Caddyfile, and /var/backups/vellur-ai-core.
set -euo pipefail

VAC_HOME="${VAC_HOME:-/opt/vellur-ai-core}"
CADDYFILE="${CADDYFILE:-/etc/caddy/Caddyfile}"
CADDY_SNIPPET="${CADDY_SNIPPET:-/etc/caddy/vellur-ai-core.caddy}"
CADDY_GROUP="${CADDY_GROUP:-caddy}"
CADDY_VALIDATE="${CADDY_VALIDATE:-sudo -u caddy caddy validate --adapter caddyfile --config}"
CADDY_RELOAD="${CADDY_RELOAD:-systemctl reload caddy}"
BACKUP_DIR="${BACKUP_DIR:-/var/backups/vellur-ai-core}"
TUNNEL_UID=10001
IMPORT_LINE="import $CADDY_SNIPPET"
IMPORT_MARK="# ── VELLUR AI CORE (managed by vac; remove with: sudo vac unexpose) ──"
CLIENTS="$VAC_HOME/secrets/gateway-clients"

c_ok=$'\e[32m'; c_warn=$'\e[33m'; c_bad=$'\e[31m'; c_dim=$'\e[2m'; c_off=$'\e[0m'
[ -t 1 ] || { c_ok=; c_warn=; c_bad=; c_dim=; c_off=; }
ok()   { echo "${c_ok}✓${c_off} $*"; }
warn() { echo "${c_warn}!${c_off} $*"; }
bad()  { echo "${c_bad}✗${c_off} $*" >&2; }
die()  { bad "$*"; exit 1; }

need_root() { [ "$(id -u)" = 0 ] || die "Run with sudo:  sudo vac $*"; }
envval() { sed -n "s/^$1=//p" "$VAC_HOME/.env" | tail -1; }
setenv() {   # setenv KEY VALUE  — edit .env in place, keeping mode 600
	local k=$1 v=$2
	if grep -q "^$k=" "$VAC_HOME/.env"; then
		awk -v k="$k" -v v="$v" 'BEGIN{FS=OFS="="} $1==k {print k "=" v; next} {print}' "$VAC_HOME/.env" > "$VAC_HOME/.env.tmp"
	else
		{ cat "$VAC_HOME/.env"; echo "$k=$v"; } > "$VAC_HOME/.env.tmp"
	fi
	chmod 600 "$VAC_HOME/.env.tmp"; mv -f "$VAC_HOME/.env.tmp" "$VAC_HOME/.env"
}
profiles() { envval COMPOSE_PROFILES; }
has_profile() { [[ ",$(profiles)," == *",$1,"* ]]; }
dc() { COMPOSE_PROFILES="$(profiles)" docker compose --project-directory "$VAC_HOME" -f "$VAC_HOME/compose.yaml" --env-file "$VAC_HOME/.env" "$@"; }
is_exposed() { [ -f "$CADDYFILE" ] && grep -qxF "$IMPORT_LINE" "$CADDYFILE"; }
new_key() { echo "sk-vellur-$(openssl rand -hex 24)"; }

set_profiles() {   # set_profiles +gpu | -gpu | +ui | -ui
	local cur; cur=$(profiles | tr ',' '\n' | sed '/^$/d')
	case $1 in
		+*) cur=$(printf '%s\n%s\n' "$cur" "${1#+}" | sed '/^$/d' | sort -u) ;;
		-*) cur=$(printf '%s\n' "$cur" | grep -vxF "${1#-}" || true) ;;
	esac
	setenv COMPOSE_PROFILES "$(printf '%s' "$cur" | paste -sd, -)"
}

# ── Caddy snippet ──────────────────────────────────────────────────────────────────
key_alternation() { awk 'NF==2 && $1 !~ /^#/ && $2 ~ /^sk-vellur-[0-9a-f]+$/ {print $2}' "$CLIENTS" 2>/dev/null | paste -sd'|' -; }

render_snippet() {
	local alt ai gw wp gp mk
	alt=$(key_alternation); [ -n "$alt" ] || die "No gateway client keys yet: sudo vac keys add opencode"
	ai=$(envval AI_DOMAIN); gw=$(envval GATEWAY_DOMAIN); wp=$(envval WEBUI_PORT); gp=$(envval GATEWAY_PORT); mk=$(envval LITELLM_MASTER_KEY)
	cat <<EOF
# VELLUR AI CORE — generated by vac. DO NOT EDIT: every vac expose/keys/ui run rewrites it.
# Holds the gateway master key: must stay mode 640, owner root:$CADDY_GROUP.

(vellur_ai_gateway) {
	# Only inference endpoints, only with a VELLUR client key. Caddy swaps the client key for the
	# internal master key: the master key never leaves this server; client keys are revocable.
	@vellur_inference path /v1/chat/completions /v1/completions /v1/embeddings /v1/models /v1/models/* /v1/responses /v1/responses/* /v1/messages /v1/messages/count_tokens
	handle @vellur_inference {
		@vellur_no_key {
			not header_regexp Authorization "^Bearer ($alt)\$"
			not header_regexp X-Api-Key "^($alt)\$"
		}
		route {
			header @vellur_no_key Content-Type "application/json"
			respond @vellur_no_key \`{"error":{"message":"Missing or invalid VELLUR AI API key.","type":"invalid_request_error","code":"invalid_api_key"}}\` 401
			reverse_proxy 127.0.0.1:$gp {
				header_up Authorization "Bearer $mk"
				header_up -X-Api-Key
				flush_interval -1
				transport http {
					read_timeout 15m
				}
			}
		}
	}
	handle /v1/* {
		header Content-Type "application/json"
		respond \`{"error":{"message":"Not found.","type":"invalid_request_error"}}\` 404
	}
	# Public liveness for the status page: says only "gateway up", nothing else.
	handle /healthz {
		rewrite * /health/liveliness
		reverse_proxy 127.0.0.1:$gp
	}
}

(vellur_ai_common) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}
	log {
		output file /var/log/caddy/vellur-ai.log
		format filter {
			wrap json
			fields {
				request>headers>X-Api-Key delete
			}
		}
	}
}

$ai {
	import vellur_ai_common
	import vellur_ai_gateway
EOF
	if has_profile ui; then
		cat <<EOF
	# Open WebUI (own login; signup disabled)
	handle {
		encode zstd gzip
		reverse_proxy 127.0.0.1:$wp
	}
}
EOF
	else
		cat <<EOF
	# Lightweight status page (static; Open WebUI is off — sudo vac ui enable)
	handle {
		encode zstd gzip
		header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; frame-ancestors 'none'"
		root * $VAC_HOME/www
		file_server
	}
}
EOF
	fi
	if [ -n "$gw" ]; then
		cat <<EOF

$gw {
	import vellur_ai_common
	import vellur_ai_gateway
	handle {
		header Content-Type "application/json"
		respond \`{"error":{"message":"Not found.","type":"invalid_request_error"}}\` 404
	}
}
EOF
	fi
}

# Apply a Caddy change atomically: back up, change, validate, reload; restore everything on failure.
caddy_apply() {   # $1 = with-import | without-import
	local stamp bak_main bak_snip tmp_snip rendered=""
	if [ "$1" = with-import ]; then rendered=$(render_snippet) || exit 1; fi
	stamp=$(date +%Y%m%d-%H%M%S)
	bak_main="$CADDYFILE.bak-vellur-ai-$stamp"
	cp -p "$CADDYFILE" "$bak_main"
	bak_snip=""; [ -f "$CADDY_SNIPPET" ] && { bak_snip="$CADDY_SNIPPET.bak-$stamp"; cp -p "$CADDY_SNIPPET" "$bak_snip"; }

	if [ "$1" = with-import ]; then
		tmp_snip=$(mktemp "$CADDY_SNIPPET.new.XXXX")
		printf '%s\n' "$rendered" > "$tmp_snip"
		chown "root:$CADDY_GROUP" "$tmp_snip"; chmod 640 "$tmp_snip"
		mv -f "$tmp_snip" "$CADDY_SNIPPET"
		mkdir -p /var/log/caddy && chown "$CADDY_GROUP:$CADDY_GROUP" /var/log/caddy 2>/dev/null || true
		is_exposed || printf '\n%s\n%s\n' "$IMPORT_MARK" "$IMPORT_LINE" >> "$CADDYFILE"
	elif is_exposed; then
		awk -v a="$IMPORT_MARK" -v b="$IMPORT_LINE" '
			$0 == "" { blank++; next }
			$0 == a || $0 == b { blank = 0; next }
			{ while (blank > 0) { print ""; blank-- } print }' "$CADDYFILE" > "$CADDYFILE.tmp-vac"
		cat "$CADDYFILE.tmp-vac" > "$CADDYFILE"; rm -f "$CADDYFILE.tmp-vac"   # keeps owner/mode of the original
	fi

	if $CADDY_VALIDATE "$CADDYFILE" >/tmp/vac-caddy-validate.log 2>&1 && $CADDY_RELOAD >>/tmp/vac-caddy-validate.log 2>&1; then
		ok "Caddy validated and reloaded (backup: $bak_main)"
		[ -n "$bak_snip" ] && rm -f "$bak_snip"
		[ "$1" = without-import ] && rm -f "$CADDY_SNIPPET"
		return 0
	fi
	cat "$bak_main" > "$CADDYFILE"
	if [ -n "$bak_snip" ]; then mv -f "$bak_snip" "$CADDY_SNIPPET"; elif [ "$1" = with-import ]; then rm -f "$CADDY_SNIPPET"; fi
	$CADDY_RELOAD >/dev/null 2>&1 || true
	bad "Caddy rejected the change. The previous configuration was restored; nothing changed."
	grep -iE 'error|invalid' /tmp/vac-caddy-validate.log | tail -5 >&2 || tail -5 /tmp/vac-caddy-validate.log >&2
	return 1
}
refresh_caddy() { if is_exposed; then caddy_apply with-import; fi; }

# ── DNS ────────────────────────────────────────────────────────────────────────────
server_ips() { { hostname -I 2>/dev/null || true; ip -o addr show scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1 || true; } | tr ' ' '\n' | sed '/^$/d' | sort -u || true; }
# Addresses that reach this server: its own interface addresses, plus the addresses of the sites the
# existing Caddy already serves (covers VPSs whose public IP is NAT-ed and not on any interface).
known_ips() {
	server_ips
	[ -r "$CADDYFILE" ] && awk '/^[a-z0-9.-]+\.[a-z][a-z]+[ \t]*\{[ \t]*$/ {print $1}' "$CADDYFILE" | sort -u | while read -r site; do
		getent ahosts "$site" 2>/dev/null | awk '{print $1}'
	done
}
resolved_ips() { getent ahosts "$1" 2>/dev/null | awk '{print $1}' | sort -u; }
dns_points_here() { local ip known; known=$(known_ips | sort -u); for ip in $(resolved_ips "$1"); do echo "$known" | grep -qxF "$ip" && return 0; done; return 1; }

# ── commands ───────────────────────────────────────────────────────────────────────
cmd_status() {
	dc ps --format 'table {{.Name}}\t{{.Status}}\t{{.Ports}}'
	echo
	docker stats --no-stream --format 'table {{.Name}}\t{{.CPUPerc}}\t{{.MemUsage}}\t{{.PIDs}}' $(dc ps -q) 2>/dev/null || true
	echo
	if is_exposed; then ok "public: https://$(envval AI_DOMAIN)  (gateway: https://$(envval AI_DOMAIN)/v1)"; else warn "not public yet (sudo vac expose)"; fi
	echo "${c_dim}profiles: ${c_off}$(profiles)${c_dim}   client keys: $(awk 'NF==2 && $1 !~ /^#/' "$CLIENTS" 2>/dev/null | wc -l)${c_off}"
	local m; m=$(grep -cE '^\s*- model_name:' "$VAC_HOME/litellm/models.yaml" || true)
	if [ "$m" -gt 0 ]; then ok "models configured: $m"; else warn "no inference backend configured (expected until the GPU is activated)"; fi
}

cmd_keys() {
	need_root keys
	mkdir -p "$VAC_HOME/secrets"; chmod 700 "$VAC_HOME/secrets"; touch "$CLIENTS"; chmod 600 "$CLIENTS"
	case "${1:-list}" in
	list) awk 'NF==2 && $1 !~ /^#/ {printf "%-20s %s…%s\n", $1, substr($2,1,14), substr($2,length($2)-3)}' "$CLIENTS" ;;
	add)
		local name=${2:?usage: vac keys add <name>} key
		[[ $name =~ ^[a-z0-9][a-z0-9_-]{0,31}$ ]] || die "Name: lowercase letters, digits, - or _"
		awk -v n="$name" '$1==n {f=1} END {exit !f}' "$CLIENTS" && die "Key '$name' already exists (revoke it first to rotate)."
		key=$(new_key); echo "$name $key" >> "$CLIENTS"
		if is_exposed && ! caddy_apply with-import; then
			awk -v n="$name" '$1!=n' "$CLIENTS" > "$CLIENTS.tmp" && mv "$CLIENTS.tmp" "$CLIENTS"; chmod 600 "$CLIENTS"
			die "Key '$name' was NOT added (Caddy refused the change; see above)."
		fi
		echo; echo "  Gateway key for '$name' (shown ONCE — store it in your password manager):"; echo; echo "    $key"; echo
		is_exposed || warn "It becomes active when the gateway is public (sudo vac expose)." ;;
	revoke)
		local name=${2:?usage: vac keys revoke <name>}
		awk -v n="$name" '$1==n {f=1} END {exit !f}' "$CLIENTS" || die "No key named '$name'."
		[ "$(awk 'NF==2 && $1 !~ /^#/' "$CLIENTS" | wc -l)" -gt 1 ] || die "Cannot revoke the last key; add a new one first."
		cp -p "$CLIENTS" "$CLIENTS.bak"
		awk -v n="$name" '$1!=n' "$CLIENTS" > "$CLIENTS.tmp" && mv "$CLIENTS.tmp" "$CLIENTS"; chmod 600 "$CLIENTS"
		if refresh_caddy; then rm -f "$CLIENTS.bak"; ok "Revoked '$name'."; else mv -f "$CLIENTS.bak" "$CLIENTS"; die "Not revoked (Caddy refused the change)."; fi ;;
	*) die "usage: vac keys list|add <name>|revoke <name>" ;;
	esac
}

cmd_expose() {
	need_root expose
	[ -f "$CADDYFILE" ] || die "$CADDYFILE not found: this server's Caddy is not where expected. Nothing changed."
	local d bad_dns=0 ips
	if is_exposed; then caddy_apply with-import; return; fi   # already public: just refresh the generated site
	if [ "${1:-}" != --force ]; then
		for d in $(envval AI_DOMAIN) $(envval GATEWAY_DOMAIN); do
			if dns_points_here "$d"; then ok "DNS $d → this server"
			else bad_dns=1; warn "DNS $d does not point to this server yet (resolves to: $(resolved_ips "$d" | tr '\n' ' ' | sed 's/ $//;s/^$/nothing/'); this server: $(known_ips | sort -u | tr '\n' ' '))"; fi
		done
		if [ $bad_dns = 1 ]; then
			ips=$(server_ips | grep -vE '^(10|127|172\.(1[6-9]|2[0-9]|3[01])|192\.168)\.|^f[cd]|^fe80|:' | head -1 || true)
			echo; echo "  In Cloudflare → DNS → Records, add (proxy status \"DNS only\", grey cloud):"
			echo "    Type A   Name ai   Content ${ips:-<server IPv4>}"
			[ -n "$(envval GATEWAY_DOMAIN)" ] && echo "    Type A   Name ${GATEWAY_LABEL:-gateway.ai}   Content ${ips:-<server IPv4>}"
			echo "  Then run again:  sudo vac expose"
			echo "  If the record already exists and resolves to this server's public IP, publish anyway: sudo vac expose --force"
			exit 2
		fi
	fi
	caddy_apply with-import
	echo "  Caddy now requests the HTTPS certificate by itself (usually under a minute)."
}

cmd_unexpose() {
	need_root unexpose
	is_exposed || { ok "Not exposed; nothing to do."; return 0; }
	caddy_apply without-import && ok "VELLUR AI CORE is no longer public. Other sites untouched."
}

cmd_ui() {
	need_root ui
	case "${1:-}" in
	enable)
		local avail; avail=$(awk '/MemAvailable/ {print int($2/1024)}' /proc/meminfo)
		echo "Open WebUI needs about 0.8–1.3 GB RAM. Available now: ${avail} MB."
		if [ "$avail" -lt 1800 ] && [ "${2:-}" != --force ]; then die "Not enough free memory to stay safe for the other projects. Nothing changed. (Override: sudo vac ui enable --force)"; fi
		set_profiles +ui; dc up -d webui
		wait_healthy vellur-ai-webui 240 || { warn "Open WebUI is not healthy; logs: sudo vac logs webui"; }
		ensure_admin
		refresh_caddy || true
		ok "Open WebUI enabled at https://$(envval AI_DOMAIN)" ;;
	disable)
		set_profiles -ui; refresh_caddy || true; dc stop webui >/dev/null 2>&1 || true; dc rm -f webui >/dev/null 2>&1 || true
		ok "Open WebUI stopped (its data volume is kept). The status page is back." ;;
	*) die "usage: vac ui enable|disable" ;;
	esac
}

ensure_admin() {   # create the single admin account on 127.0.0.1 before anyone else can
	local wp cfg email pw resp
	wp=$(envval WEBUI_PORT)
	cfg=$(curl -fsS -m 5 "http://127.0.0.1:$wp/api/config" 2>/dev/null || true)
	echo "$cfg" | grep -q '"onboarding":true' || return 0
	read -r -p "Email for the VELLUR AI admin account: " email
	[[ $email == *@*.* ]] || die "Not an email address."
	pw="$(openssl rand -base64 24 | tr -d '/+=' | cut -c1-24)"
	resp=$(curl -sS -m 15 -H 'content-type: application/json' \
		-d "{\"name\":\"VELLUR Admin\",\"email\":\"$email\",\"password\":\"$pw\"}" "http://127.0.0.1:$wp/api/v1/auths/signup")
	echo "$resp" | grep -q '"role":"admin"' || die "Could not create the admin account: $resp"
	umask 077; printf 'email: %s\npassword: %s\n' "$email" "$pw" > "$VAC_HOME/secrets/webui-admin.txt"
	echo; echo "  Admin account created. Password (also in $VAC_HOME/secrets/webui-admin.txt, root only):"; echo; echo "    $pw"; echo
	echo "  Save it in your password manager, change it after the first login, then delete that file."
}

cmd_gpu() {
	need_root gpu
	local s="$VAC_HOME/secrets"
	case "${1:-status}" in
	init)
		command -v ssh-keygen >/dev/null || die "ssh-keygen missing: sudo apt-get install -y openssh-client"
		mkdir -p "$s"; chmod 700 "$s"
		if [ ! -f "$s/gpu_ed25519" ]; then
			ssh-keygen -q -t ed25519 -N "" -C "vellur-ai-core-tunnel" -f "$s/gpu_ed25519"
			chown "$TUNNEL_UID:$TUNNEL_UID" "$s/gpu_ed25519" "$s/gpu_ed25519.pub"; chmod 600 "$s/gpu_ed25519"
		fi
		touch "$s/gpu_known_hosts"; chown "$TUNNEL_UID:$TUNNEL_UID" "$s/gpu_known_hosts"; chmod 644 "$s/gpu_known_hosts"
		[ -n "$(envval VELLUR_GPU_API_KEY)" ] || setenv VELLUR_GPU_API_KEY "vllm-$(openssl rand -hex 24)"
		echo; echo "1) Public key — add it in HyperAI (account settings → SSH keys) or the GPU host's ~/.ssh/authorized_keys:"
		echo; echo "    $(cat "$s/gpu_ed25519.pub")"
		echo; echo "2) vLLM API key — use it as VLLM_API_KEY in gpu/hyperai-serve.sh on the GPU workspace:"
		echo; echo "    $(envval VELLUR_GPU_API_KEY)"
		echo; echo "Neither key gives access to this VPS, GitHub or any production system." ;;
	connect)
		local host port user fp
		if [[ ${2:-} =~ ^[0-9]+$ ]]; then   # vac gpu connect <port>: same host as last time (default ssh.hyper.ai)
			port=$2; host=$(envval GPU_SSH_HOST); host=${host:-ssh.hyper.ai}; user=${3:-root}
		else
			host=${2:?usage: vac gpu connect [<ssh-host>] <ssh-port> [user]}; port=${3:?usage: vac gpu connect [<ssh-host>] <ssh-port> [user]}; user=${4:-root}
		fi
		[ -f "$s/gpu_ed25519" ] || die "Run first: sudo vac gpu init"
		[[ $port =~ ^[0-9]+$ ]] || die "Port must be a number."
		echo "Fetching the SSH host key of $host:$port …"
		ssh-keyscan -T 10 -p "$port" "$host" 2>/dev/null </dev/null > "$s/gpu_known_hosts.new" || true
		[ -s "$s/gpu_known_hosts.new" ] || die "No answer from $host:$port. Is the GPU workspace running?"
		echo "Host key fingerprints (compare with the provider's panel if it shows them):"
		ssh-keygen -lf "$s/gpu_known_hosts.new" </dev/null | sed 's/^/    /'
		read -r -p "Trust this host? [y/N] " fp || fp=""; [[ $fp =~ ^[Yy]$ ]] || { rm -f "$s/gpu_known_hosts.new"; die "Cancelled."; }
		mv -f "$s/gpu_known_hosts.new" "$s/gpu_known_hosts"; chown "$TUNNEL_UID:$TUNNEL_UID" "$s/gpu_known_hosts"; chmod 644 "$s/gpu_known_hosts"
		setenv GPU_SSH_HOST "$host"; setenv GPU_SSH_PORT "$port"; setenv GPU_SSH_USER "$user"
		ensure_gpu_models
		cmd_gpu up ;;
	up)
		[ -n "$(envval GPU_SSH_HOST)" ] || die "No GPU workspace yet: sudo vac gpu connect <host> <port>"
		set_profiles +gpu
		docker image inspect vellur-ai-core/gpu-tunnel:local >/dev/null 2>&1 || dc build gpu-tunnel
		dc up -d gpu-tunnel
		dc up -d gateway            # picks up the GPU variables
		wait_healthy vellur-ai-gateway 90 || warn "gateway not healthy yet: sudo vac logs gateway"
		echo "Waiting for the tunnel …"
		if wait_healthy vellur-ai-gpu-tunnel 60; then ok "Tunnel up."; cmd_gpu test || true
		else warn "Tunnel not up yet (is vLLM running on the GPU?). Logs: sudo vac logs gpu-tunnel"; fi ;;
	down)
		set_profiles -gpu; dc stop gpu-tunnel >/dev/null 2>&1 || true
		ok "Tunnel stopped. IMPORTANT: also stop the GPU workspace in HyperAI, otherwise it keeps billing." ;;
	status)
		echo "workspace: $(envval GPU_SSH_USER)@$(envval GPU_SSH_HOST):$(envval GPU_SSH_PORT)   tunnel: $(docker inspect -f '{{.State.Status}} {{if .State.Health}}{{.State.Health.Status}}{{end}}' vellur-ai-gpu-tunnel 2>/dev/null || echo 'not created')" ;;
	test)
		local gp mk out
		gp=$(envval GATEWAY_PORT); mk=$(envval LITELLM_MASTER_KEY)
		out=$(curl -sS -m 120 -H "Authorization: Bearer $mk" -H 'content-type: application/json' \
			-d '{"model":"vellur-coder","max_tokens":400,"messages":[{"role":"user","content":"Reply with the single word: ready"}]}' \
			"http://127.0.0.1:$gp/v1/chat/completions" || true)
		if echo "$out" | grep -q '"choices"'; then ok "The backend answered through the gateway: $(echo "$out" | grep -oE '"content":"[^"]*"' | head -1)"
		else bad "No inference yet: $(echo "$out" | head -c 300)"; return 1; fi ;;
	*) die "usage: vac gpu init|connect <host> <port>|up|down|status|test" ;;
	esac
}

ensure_gpu_models() {   # activate the GPU model entries once (keeps any custom models.yaml)
	local m="$VAC_HOME/litellm/models.yaml"
	if ! grep -qE '^\s*- model_name:' "$m"; then
		cp -p "$m" "$m.bak-$(date +%Y%m%d-%H%M%S)"
		cp "$VAC_HOME/litellm/models.gpu.yaml" "$m"
		ok "Activated model 'vellur-coder' (litellm/models.yaml; previous file backed up)."
	fi
}

cmd_backup() {
	need_root backup
	mkdir -p "$BACKUP_DIR"; chmod 700 "$BACKUP_DIR"
	local stamp out tmp vol=""
	stamp=$(date +%Y%m%d-%H%M%S); out="$BACKUP_DIR/vellur-ai-core-$stamp.tar.gz"; tmp=$(mktemp -d)
	tar -C "$VAC_HOME" -czf "$tmp/config.tar.gz" .env secrets litellm
	if docker volume inspect vellur-ai-core-webui-data >/dev/null 2>&1; then
		vol=$(docker volume inspect -f '{{.Mountpoint}}' vellur-ai-core-webui-data)
		local running=0; docker ps -q --filter name=^vellur-ai-webui$ | grep -q . && running=1
		[ $running = 1 ] && { echo "Pausing Open WebUI for a consistent copy (a few seconds)…"; dc stop webui >/dev/null; }
		tar -C "$vol" -czf "$tmp/webui-data.tar.gz" . || true
		[ $running = 1 ] && dc start webui >/dev/null
	fi
	tar -C "$tmp" -czf "$out" . && rm -rf "$tmp"; chmod 600 "$out"
	ok "Backup: $out ($(du -h "$out" | cut -f1)). It contains secrets: keep it private."
}

cmd_restore() {
	need_root restore
	local file=${1:?usage: vac restore <backup.tar.gz>} tmp vol a
	[ -f "$file" ] || die "No such file: $file"
	tmp=$(mktemp -d); tar -C "$tmp" -xzf "$file"; [ -f "$tmp/config.tar.gz" ] || die "Not a vac backup."
	read -r -p "Replace the current VELLUR AI CORE settings/data with this backup? Type RESTORE: " a; [ "$a" = RESTORE ] || die "Cancelled."
	cmd_backup >/dev/null && ok "Safety backup of the current state made first."
	dc stop >/dev/null
	tar -C "$VAC_HOME" -xzf "$tmp/config.tar.gz"
	if [ -f "$tmp/webui-data.tar.gz" ]; then
		docker volume create vellur-ai-core-webui-data >/dev/null
		vol=$(docker volume inspect -f '{{.Mountpoint}}' vellur-ai-core-webui-data)
		find "$vol" -mindepth 1 -delete; tar -C "$vol" -xzf "$tmp/webui-data.tar.gz"
	fi
	rm -rf "$tmp"; dc up -d >/dev/null; refresh_caddy || true
	ok "Restored from $file"
}

wait_healthy() {   # $1 = container, $2 = seconds
	local i s
	for ((i = 0; i < $2; i += 3)); do
		s=$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$1" 2>/dev/null || echo missing)
		[ "$s" = healthy ] && return 0
		sleep 3
	done
	return 1
}

cmd_verify() {
	local fails=0 master gp wp ai key cs=(vellur-ai-gateway)
	t() { if eval "$2" >/dev/null 2>&1; then ok "$1"; else bad "$1"; fails=$((fails + 1)); fi; }
	master=$(envval LITELLM_MASTER_KEY); gp=$(envval GATEWAY_PORT); wp=$(envval WEBUI_PORT); ai=$(envval AI_DOMAIN)
	has_profile ui && cs+=(vellur-ai-webui); has_profile gpu && cs+=(vellur-ai-gpu-tunnel)
	echo "── containers (${cs[*]})"
	t "gateway healthy"                    "wait_healthy vellur-ai-gateway 90"
	t "restart policy unless-stopped"      "[ \"\$(docker inspect -f '{{.HostConfig.RestartPolicy.Name}}' ${cs[*]} | sort -u)\" = unless-stopped ]"
	t "memory limits on every container"   "! docker inspect -f '{{.HostConfig.Memory}}' ${cs[*]} | grep -qx 0"
	t "log rotation on every container"    "! docker inspect -f '{{index .HostConfig.LogConfig.Config \"max-size\"}}' ${cs[*]} | grep -qvx 10m"
	t "no Docker socket mounted"           "! docker inspect -f '{{range .Mounts}}{{.Source}} {{end}}' ${cs[*]} | grep -q docker.sock"
	t "no privileged container"            "! docker inspect -f '{{.HostConfig.Privileged}}' ${cs[*]} | grep -qx true"
	echo "── isolation"
	t "host ports only on 127.0.0.1"       "! docker inspect -f '{{range \$p,\$b := .NetworkSettings.Ports}}{{range \$b}}{{.HostIp}} {{end}}{{end}}' ${cs[*]} | tr ' ' '\n' | sed '/^\$/d' | grep -vqxF 127.0.0.1"
	t "own network vellur-ai-core"         "docker network inspect vellur-ai-core"
	echo "── gateway (local)"
	t "liveliness"                         "curl -fsS -m 5 http://127.0.0.1:$gp/health/liveliness"
	t "rejects requests without key"       "[ \"\$(curl -s -o /dev/null -w '%{http_code}' -m 5 http://127.0.0.1:$gp/v1/models)\" = 401 ]"
	t "lists models with master key"       "curl -fsS -m 5 -H 'Authorization: Bearer $master' http://127.0.0.1:$gp/v1/models | grep -q '\"object\":\"list\"'"
	if has_profile ui; then
		echo "── Open WebUI (local)"
		t "healthy"                        "wait_healthy vellur-ai-webui 180"
		t "signup is closed"               "curl -fsS -m 5 http://127.0.0.1:$wp/api/config | grep -q '\"enable_signup\":false'"
		t "admin account exists"           "! curl -fsS -m 5 http://127.0.0.1:$wp/api/config | grep -q '\"onboarding\":true'"
		t "API refuses anonymous access"   "[ \"\$(curl -s -o /dev/null -w '%{http_code}' -m 5 http://127.0.0.1:$wp/api/models)\" = 401 ]"
	fi
	if is_exposed; then
		echo "── public (HTTPS, https://$ai)"
		key=$(awk 'NF==2 && $1 !~ /^#/ {print $2; exit}' "$CLIENTS")
		code() { curl -s -o /dev/null -w '%{http_code}' -m 15 "$@"; }
		t "valid certificate + page answers"   "curl -fsS -m 15 -o /dev/null https://$ai/"
		t "/healthz → 200"                     "[ \"\$(code https://$ai/healthz)\" = 200 ]"
		t "/v1 without key → 401"              "[ \"\$(code https://$ai/v1/models)\" = 401 ]"
		t "/v1 wrong key → 401"                "[ \"\$(code -H 'Authorization: Bearer sk-vellur-wrong' https://$ai/v1/models)\" = 401 ]"
		t "/v1 master key refused publicly"    "[ \"\$(code -H 'Authorization: Bearer $master' https://$ai/v1/models)\" = 401 ]"
		t "/v1 client key → 200"               "[ \"\$(code -H 'Authorization: Bearer $key' https://$ai/v1/models)\" = 200 ]"
		t "gateway admin paths hidden"         "[ \"\$(code -H 'Authorization: Bearer $key' https://$ai/v1/key/generate)\" = 404 ] && [ \"\$(code https://$ai/key/generate)\" != 200 ]"
	else
		warn "public checks skipped: not exposed yet (sudo vac expose)"
	fi
	echo "── inference"
	if curl -fsS -m 5 -H "Authorization: Bearer $master" "http://127.0.0.1:$gp/v1/models" 2>/dev/null | grep -q '"data":\[\]'; then
		warn "no inference backend configured — requests get \"invalid model\" (expected until the GPU is activated)"
	elif has_profile gpu; then cmd_gpu test || fails=$((fails + 1))
	else warn "models configured but the GPU tunnel is off (sudo vac gpu up when the workspace runs)"; fi
	echo
	[ $fails = 0 ] && ok "All checks passed." || { bad "$fails check(s) failed."; return 1; }
}

case "${1:-help}" in
	status) shift; cmd_status ;;
	verify) cmd_verify ;;
	logs) shift; follow=""; svc=""; for a in "$@"; do [ "$a" = -f ] && follow=-f || svc=$a; done; dc logs --tail 100 $follow ${svc:+"$svc"} ;;
	start) shift; need_root start; dc up -d "$@" ;;
	stop) shift; need_root stop; dc stop "$@" ;;
	restart) shift; need_root restart; if [ $# -gt 0 ]; then dc up -d --force-recreate "$@"; else dc up -d --force-recreate; fi ;;
	update) need_root update; dc pull --ignore-buildable; dc up -d --build; cmd_verify || true ;;
	keys) shift; cmd_keys "$@" ;;
	expose) shift; cmd_expose "$@" ;;
	unexpose) cmd_unexpose ;;
	gpu) shift; cmd_gpu "$@" ;;
	ui) shift; cmd_ui "$@" ;;
	backup) cmd_backup ;;
	restore) shift; cmd_restore "$@" ;;
	render-snippet) render_snippet ;;   # for tests / review
	*) sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
