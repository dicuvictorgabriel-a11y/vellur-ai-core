#!/usr/bin/env bash
# vac-autoupdate — install APPROVED releases of VELLUR AI Core on this server, with checks and rollback.
# Used through:  sudo vac autoupdate on | off | status | run | install <commit|latest> [--force] | rollback
#
# Nothing is ever installed just because it was pushed to GitHub. A release is installed only when the owner
# approved that exact commit: in the dashboard (Activity → VELLUR version → "Install this version") or here on
# the server with `vac autoupdate install`. The agent cannot install anything: it has no access to this script.
#
#   on        check every 2 minutes whether the owner approved a release in the dashboard (systemd timer)
#   off       stop checking (nothing else changes)
#   status    installed version, previous version, last result
#   run       one check now (what the timer calls)
#   install   install a commit of the configured repository now (approval = you typing this command)
#   rollback  re-install the previous release kept on disk — works even when the dashboard is broken
#
# How a release is installed (the same installer a manual deploy runs):
#   1. the commit's automated tests on GitHub (CI) must have passed (skip only with --force);
#   2. wait while an agent task is running (installing restarts the agent container);
#   3. download exactly that commit and the React files CI built for it, run its install.sh, then `vac verify`;
#   4. if the installer or the checks fail: re-install the previous release; that commit is retried only after the
#      owner approves it again (or with --force for a manual install).
set -uo pipefail

DEST="${VAC_HOME:-/opt/vellur-ai-core}"
ENVF="$DEST/.env"
envval() { [ -f "$ENVF" ] && sed -n "s/^$1=//p" "$ENVF" | tail -1; }
REPO="${AUTOUPDATE_REPO:-$(envval AUTOUPDATE_REPO)}"; REPO="${REPO:-dicuvictorgabriel-a11y/vellur-ai-core}"
BRANCH="${AUTOUPDATE_BRANCH:-$(envval AUTOUPDATE_BRANCH)}"; BRANCH="${BRANCH:-main}"
API="${AUTOUPDATE_API:-https://api.github.com}"
CODELOAD="${AUTOUPDATE_CODELOAD:-https://codeload.github.com}"
GITHUB="${AUTOUPDATE_GITHUB:-https://github.com}"
LOG="${AUTOUPDATE_LOG:-/var/log/vellur-autoupdate.log}"
REL="$DEST/releases"
UNIT="${AUTOUPDATE_UNIT_DIR:-/etc/systemd/system}/vellur-autoupdate"
VAC="${AUTOUPDATE_VAC:-/usr/local/bin/vac}"
LOCAL="${AUTOUPDATE_LOCAL_API:-}"      # tests only: base URL of the controller's admin API

say()  { echo "$(date -u +%FT%TZ) $*" | tee -a "$LOG" >&2; }
[[ $REPO =~ ^[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9._-]+$ && $BRANCH =~ ^[A-Za-z0-9._/-]+$ ]] || { echo "invalid AUTOUPDATE_REPO / AUTOUPDATE_BRANCH" >&2; exit 2; }
cur_sha()  { cat "$DEST/.release-sha" 2>/dev/null || true; }
cur_dir()  { cat "$DEST/.release-current" 2>/dev/null || true; }
prev_dir() { cat "$DEST/.release-prev" 2>/dev/null || true; }

local_api() {   # local_api METHOD path [json]  → body on stdout, non-zero when the dashboard is unreachable
	local base=$LOCAL secret
	secret=$(envval AUTOPILOT_ADMIN_SECRET)
	[ -n "$base" ] || { local port; port=$(envval AUTOPILOT_PORT); [ -n "$port" ] || return 1; base="http://127.0.0.1:$port"; }
	curl -fsS -m 15 -X "$1" -H "X-Vellur-Admin: $secret" -H "X-Vellur-Request: 1" -H 'content-type: application/json' \
		${3:+-d "$3"} "$base/autopilot/api/$2" 2>/dev/null
}
note() {        # remember the last result and tell the dashboard
	printf '%s\n' "$1" > "$DEST/.autoupdate-last"
	local body
	body=$(INSTALLED=$(cur_sha) PREV=$(basename "$(prev_dir)" 2>/dev/null) LAST=$1 CLEAR=${2:-} python3 -c 'import json,os
print(json.dumps({"installed": os.environ["INSTALLED"], "previous": os.environ["PREV"], "last": os.environ["LAST"], "clear": os.environ["CLEAR"]}))')
	local_api POST release/report "$body" >/dev/null || true
}

resolve_sha() {   # resolve_sha <commit|latest> → full 40-character id of a commit that exists in the repository
	local ref=$1 sha
	[ "$ref" = latest ] && ref=$BRANCH
	sha=$(curl -fsS -m 30 -H 'Accept: application/vnd.github.sha' "$API/repos/$REPO/commits/$ref" 2>/dev/null) || return 1
	[[ $sha =~ ^[0-9a-f]{40}$ ]] && echo "$sha"
}
ci_state() {      # passed | failed | pending | none
	curl -fsS -m 30 -H 'Accept: application/vnd.github+json' "$API/repos/$REPO/commits/$1/check-runs?per_page=100" 2>/dev/null | python3 -c 'import json,sys
try: runs = json.load(sys.stdin).get("check_runs", [])
except Exception: runs = None
if runs is None: print("none")
elif not runs: print("none")
elif any(r.get("status") != "completed" for r in runs): print("pending")
elif all(r.get("conclusion") in ("success", "skipped", "neutral") for r in runs): print("passed")
else: print("failed")' 2>/dev/null || echo none
}
react_build() {   # react_build <extracted-source> <sha>: add the UI that CI built for this exact commit
	local src=$1 sha=$2 dest="$1/autopilot/app/static/react" part="$1/.react-build"
	[ -f "$src/frontend/package.json" ] || return 0   # older commits have no React app
	rm -rf -- "$dest" "$part"; mkdir -p "$part"
	if ! curl -fsSL -m 300 "$GITHUB/$REPO/releases/download/nova-build-$sha/nova-react-build.tar.gz" | tar -xz -C "$part" 2>/dev/null ||
		[ ! -f "$part/index.html" ]; then
		rm -rf -- "$part"; return 1
	fi
	mv "$part" "$dest"
}
agent_busy() {   # 0 = a task is running right now
	local_api GET agent | python3 -c 'import json,sys
final = {"done", "failed", "cancelled", "timeout", "over_budget"}
sys.exit(0 if any(t.get("state") not in final for t in json.load(sys.stdin).get("tasks", [])) else 1)' 2>/dev/null
}
install_dir() {  # install_dir <dir> → 0 when the installer and the checks pass
	( cd "$1" && bash ./install.sh ) >> "$LOG" 2>&1 < /dev/null || return 1
	"$VAC" verify >> "$LOG" 2>&1 < /dev/null
}
locked() { mkdir -p "$REL"; exec 9> "$DEST/.autoupdate.lock"; flock -n 9 || { echo "another update is in progress"; exit 0; }; }

do_rollback() {
	local prev cur
	prev=$(prev_dir); cur=$(cur_dir)
	[ -n "$prev" ] && [ -f "$prev/install.sh" ] || { note "nothing to roll back to: no previous release is kept on this server" rollback; say "rollback: no previous release"; return 1; }
	say "rolling back to $(basename "$prev")"
	if install_dir "$prev"; then
		echo "$prev" > "$DEST/.release-current"; [ -n "$cur" ] && echo "$cur" > "$DEST/.release-prev"
		basename "$prev" | grep -Eq '^[0-9a-f]{40}$' && basename "$prev" > "$DEST/.release-sha" || : > "$DEST/.release-sha"
		note "rolled back to $(basename "$prev" | cut -c1-12) on $(date -u +'%F %H:%M UTC')" rollback; say "rolled back"; return 0
	fi
	note "rollback to $(basename "$prev" | cut -c1-12) FAILED: run the installer by hand (see $LOG)" rollback; say "ROLLBACK FAILED"; return 1
}

do_install() {   # do_install <sha> [--force] [approval]  (approval: dashboard timestamp, or "manual")
	local sha=$1 force=${2:-} approval=${3:-} cur failed failed_approval ci tmp old
	cur=$(cur_sha); failed=$(cat "$DEST/.release-failed" 2>/dev/null || true)
	failed_approval=$(cat "$DEST/.release-failed-approval" 2>/dev/null || true)
	[ "$sha" = "$cur" ] && { note "version ${sha:0:7} is already installed" approved; return 0; }
	# A failed commit is not retried by the timer alone; only a NEW owner approval (or --force / a manual install) is consent.
	if [ "$sha" = "$failed" ] && [ "$force" != --force ] &&
		{ [ "$approval" = manual ] || [ "$approval" = "$failed_approval" ]; }; then
		note "version ${sha:0:7} failed to install earlier; approve it again in the dashboard (or run install with --force) to retry" approved
		return 0
	fi
	if [ "$force" != --force ]; then
		ci=$(ci_state "$sha")
		case $ci in
			passed) ;;
			pending) note "version ${sha:0:7} waits: its automated tests are still running on GitHub"; return 0 ;;
			failed) note "version ${sha:0:7} was NOT installed: its automated tests failed on GitHub" approved; say "refused ${sha:0:7}: CI failed"; return 1 ;;
			*) note "version ${sha:0:7} was NOT installed: no automated test result was found for it on GitHub" approved; say "refused ${sha:0:7}: no CI result"; return 1 ;;
		esac
		if agent_busy; then note "version ${sha:0:7} waits: an agent task is running"; return 0; fi
	fi
	say "installing ${sha:0:7} (current: ${cur:0:7})"
	tmp="$REL/$sha.tmp"; rm -rf -- "$tmp" "${REL:?}/$sha"; mkdir -p "$tmp"
	if ! curl -fsSL -m 300 "$CODELOAD/$REPO/tar.gz/$sha" | tar -xz -C "$tmp" --strip-components=1 || [ ! -f "$tmp/install.sh" ]; then
		rm -rf -- "$tmp"; note "download of ${sha:0:7} failed; will try again"; say "download failed"; return 1
	fi
	if ! react_build "$tmp" "$sha"; then
		rm -rf -- "$tmp"
		note "version ${sha:0:7} was NOT installed: GitHub has no installable React build for it (tag nova-build-${sha:0:7})" approved
		say "refused ${sha:0:7}: missing React build"
		return 1
	fi
	mv "$tmp" "$REL/$sha"
	old=$(cur_dir)
	if install_dir "$REL/$sha"; then
		echo "$sha" > "$DEST/.release-sha"; rm -f "$DEST/.release-failed" "$DEST/.release-failed-approval"
		[ -n "$old" ] && [ "$old" != "$REL/$sha" ] && echo "$old" > "$DEST/.release-prev"
		echo "$REL/$sha" > "$DEST/.release-current"
		for d in "$REL"/*; do     # keep only the current and the previous release
			[ -d "$d" ] && [ "$d" != "$(cur_dir)" ] && [ "$d" != "$(prev_dir)" ] && rm -rf -- "$d"
		done
		note "installed ${sha:0:7} on $(date -u +'%F %H:%M UTC')" approved; say "installed ${sha:0:7}"; return 0
	fi
	echo "$sha" > "$DEST/.release-failed"; printf '%s\n' "$approval" > "$DEST/.release-failed-approval"; say "install of ${sha:0:7} FAILED"
	rm -rf -- "${REL:?}/$sha"
	if [ -n "$old" ] && [ -f "$old/install.sh" ]; then
		say "restoring $(basename "$old")"
		if install_dir "$old"; then note "version ${sha:0:7} failed its checks; the previous version was restored" approved; say "restored"
		else note "version ${sha:0:7} failed and restoring the previous version also failed: run the installer by hand" approved; say "RESTORE FAILED"; fi
	else
		note "version ${sha:0:7} failed its checks and no earlier release is kept on disk; see $LOG" approved
	fi
	return 1
}

run() {
	locked
	local pend approved approved_at request
	pend=$(local_api GET release/pending) || { say "dashboard not reachable; nothing to do (use: vac autoupdate install|rollback)"; return 0; }
	approved=$(printf '%s' "$pend" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("approved") or "")' 2>/dev/null)
	approved_at=$(printf '%s' "$pend" | python3 -c 'import json,sys; a=json.load(sys.stdin).get("approved_at") or ""; print(a)' 2>/dev/null)
	request=$(printf '%s' "$pend" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("request") or "")' 2>/dev/null)
	if [ "$request" = rollback ]; then do_rollback; return; fi
	if [[ $approved =~ ^[0-9a-f]{40}$ ]] && [ "$approved" != "$(cur_sha)" ]; then
		local sha; sha=$(resolve_sha "$approved") || { note "approved version ${approved:0:7} was not found in $REPO" approved; return 1; }
		do_install "$sha" "" "$approved_at"; return
	fi
	note "$(cat "$DEST/.autoupdate-last" 2>/dev/null || echo "waiting for an approved release")"
}

status() {
	echo "repository: $REPO ($BRANCH)"
	echo "installed:  $(cur_sha | grep . || echo 'installed by hand (version id unknown)')"
	echo "previous:   $(basename "$(prev_dir)" 2>/dev/null | grep . || echo none kept)"
	echo "approvals:  $(systemctl is-active vellur-autoupdate.timer 2>/dev/null | sed 's/^active$/checked every 2 minutes/' || true)"
	echo "last:       $(cat "$DEST/.autoupdate-last" 2>/dev/null || echo never ran)"
}

need_root() { [ "$(id -u)" = 0 ] || [ -n "${AUTOUPDATE_NO_ROOT:-}" ] || { echo "run with sudo" >&2; exit 2; }; }
case "${1:-status}" in
	run) run ;;
	status) status ;;
	install)
		need_root; locked
		sha=$(resolve_sha "${2:?usage: vac autoupdate install <commit|latest> [--force]}") || { echo "commit not found in $REPO" >&2; exit 1; }
		do_install "$sha" "${3:-}" manual; rc=$?; cat "$DEST/.autoupdate-last"; exit $rc ;;
	rollback) need_root; locked; do_rollback; rc=$?; cat "$DEST/.autoupdate-last"; exit $rc ;;
	on)
		need_root
		printf '[Unit]\nDescription=VELLUR AI Core: install approved releases\nAfter=network-online.target docker.service\n\n[Service]\nType=oneshot\nExecStart=%s run\nTimeoutStartSec=3600\n' "$DEST/bin/vac-autoupdate" > "$UNIT.service"
		printf '[Unit]\nDescription=Check for an approved VELLUR AI Core release\n\n[Timer]\nOnBootSec=3min\nOnUnitActiveSec=2min\nRandomizedDelaySec=15\n\n[Install]\nWantedBy=timers.target\n' > "$UNIT.timer"
		systemctl daemon-reload && systemctl enable --now vellur-autoupdate.timer
		echo "Release installation is ON. Nothing is installed until you approve a version in the dashboard"
		echo "(Activity → VELLUR version) or run: sudo vac autoupdate install latest"
		run; status ;;
	off)
		need_root
		systemctl disable --now vellur-autoupdate.timer 2>/dev/null; rm -f "$UNIT.service" "$UNIT.timer"; systemctl daemon-reload
		echo "Release installation is OFF. Nothing else changed." ;;
	*) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
