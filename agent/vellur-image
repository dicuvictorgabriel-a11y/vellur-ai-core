#!/usr/bin/env python3
"""vellur-image — generate a real image through VELLUR and save it in the agent workspace.

usage: vellur-image "<prompt>" [--size 1024x1024] [--n 1] [--out DIR_OR_FILE] [--json]

The image is generated by the image model the owner configured in VELLUR (Models → Image generation). It is stored
on the server, appears in the task's image list, and is also saved here so you can reference or inspect it. Paid
generation is only allowed when the owner enabled it and the estimated cost is below the agent's image limit.
"""
import json
import os
import re
import sys
import urllib.error
import urllib.request
from pathlib import Path

MAX_BYTES = 25 * 1024 * 1024
EXT = {"image/png": ".png", "image/jpeg": ".jpg", "image/webp": ".webp", "image/gif": ".gif"}


def fail(message, code=1):
    print(f"error: {message}", file=sys.stderr)
    return code


def parse(argv):
    prompt, size, n, out, as_json = [], "1024x1024", 1, "", False
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-h", "--help"):
            print(__doc__.strip())
            raise SystemExit(0)
        if a in ("--size", "--n", "--out"):
            if i + 1 >= len(argv):
                raise SystemExit(fail(f"{a} needs a value", 2))
            if a == "--size":
                size = argv[i + 1]
            elif a == "--n":
                try:
                    n = int(argv[i + 1])
                except ValueError:
                    raise SystemExit(fail("--n must be a number", 2))
            else:
                out = argv[i + 1]
            i += 2
            continue
        if a == "--json":
            as_json = True
            i += 1
            continue
        if a.startswith("--"):
            raise SystemExit(fail(f"unknown option {a}", 2))
        prompt.append(a)
        i += 1
    text = " ".join(prompt).strip()
    if not text:
        raise SystemExit(fail("write a description of the image", 2))
    if not re.fullmatch(r"\d{3,4}x\d{3,4}", size):
        raise SystemExit(fail("--size must look like 1024x1024", 2))
    if not 1 <= n <= 4:
        raise SystemExit(fail("--n must be between 1 and 4", 2))
    return text, size, n, out, as_json


def request(url, payload=None):
    headers = {"Content-Type": "application/json", "X-Runner-Secret": os.environ.get("VELLUR_RUNNER_SECRET", "")}
    data = json.dumps(payload).encode() if payload is not None else None
    req = urllib.request.Request(url, data=data, headers=headers, method="POST" if data else "GET")
    try:
        with urllib.request.urlopen(req, timeout=300) as r:
            return r.status, r.read()
    except urllib.error.HTTPError as e:
        return e.code, e.read()
    except (urllib.error.URLError, TimeoutError) as e:
        raise SystemExit(fail(f"VELLUR is unreachable ({e.__class__.__name__})"))


def target_file(out, mime, iid, total):
    root = Path.cwd().resolve()
    if out:
        p = Path(out).expanduser()
        p = p if p.is_absolute() else root / p
        p = p.resolve()
        if p != root and root not in p.parents:
            raise SystemExit(fail("--out must stay inside the task workspace", 2))
        if p.exists() and p.is_dir():
            p = p / (iid + EXT.get(mime, ".png"))
    else:
        p = root / "generated-images" / (iid + EXT.get(mime, ".png"))
    if total > 1 and p.suffix:
        p = p.with_name(f"{p.stem}-{iid[-6:]}{p.suffix}")
    p.parent.mkdir(parents=True, exist_ok=True)
    return p


def main(argv):
    prompt, size, n, out, as_json = parse(argv)
    base = os.environ.get("VELLUR_IMAGE_URL", "http://autopilot:8080/autopilot/api/agent/images").rstrip("/")
    task = os.environ.get("VELLUR_TASK_ID", "")
    if not task.isdigit():
        return fail("image generation is not available in this workspace (VELLUR_TASK_ID missing)")
    if not os.environ.get("VELLUR_RUNNER_SECRET"):
        return fail("image generation is not available in this workspace (runner secret missing)")
    status, raw = request(base, {"prompt": prompt, "task_id": int(task), "size": size, "n": n})
    try:
        data = json.loads(raw or b"{}")
    except ValueError:
        return fail(f"VELLUR answered HTTP {status} with invalid JSON")
    if status >= 400 or data.get("error"):
        message = data.get("message") or data.get("error") or f"HTTP {status}"
        if data.get("error") == "image_confirmation":
            message += " Ask the owner to enable/confirm image generation in Models."
        return fail(str(message))
    images = data.get("images") or []
    if not images:
        return fail("VELLUR returned no image")
    saved = []
    for img in images:
        iid = str(img.get("id") or "")
        if not re.fullmatch(r"img_[a-f0-9]{32}", iid):
            return fail("VELLUR returned an invalid image id")
        path = target_file(out, str(img.get("mime") or ""), iid, len(images))
        code, body = request(f"{base}/{iid}/content")
        if code >= 400 or not body:
            return fail(f"could not download image {iid} (HTTP {code})")
        if len(body) > MAX_BYTES:
            return fail("the generated image is too large")
        path.write_bytes(body)
        saved.append({"id": iid, "path": str(path), "mime": img.get("mime"), "width": img.get("width"),
                      "height": img.get("height"), "cost_usd": img.get("cost_usd")})
    if as_json:
        print(json.dumps({"images": saved, "cost_usd": data.get("cost_usd"),
                          "cost_source": data.get("cost_source"), "target": data.get("target")}, indent=2))
    else:
        for s in saved:
            print(f"Saved {s['path']} ({s['width']}x{s['height']}, {s['id']})")
        if data.get("cost_source") == "unpriced":
            print("Cost: unknown (no image price configured).")
        elif data.get("cost_source"):
            print(f"Cost: ${float(data.get('cost_usd') or 0):.4f} ({data['cost_source']})")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
