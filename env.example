# VELLUR AI CORE — /opt/vellur-ai-core/.env  (install.sh generates the real file, mode 600)
# This example holds NO secrets. Never commit the real .env.

# One public name serves both the interface (/) and the gateway (/v1).
AI_DOMAIN=ai.vellurdigital.com
# Optional second name for the gateway only (needs its own DNS record). Empty = off.
GATEWAY_DOMAIN=

# Optional components (compose profiles): "gpu" = SSH tunnel to the GPU, "ui" = Open WebUI (~1 GB RAM).
COMPOSE_PROFILES=

# Loopback ports (Caddy → containers). Change only if install.sh reports them busy.
WEBUI_PORT=3310
GATEWAY_PORT=3311

# Pinned images (update deliberately: edit, then  sudo vac update)
LITELLM_IMAGE=docker.io/litellm/litellm:v1.108.7-lts
WEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.13.3

# Generated secrets (openssl rand). Placeholders only.
LITELLM_MASTER_KEY=sk-vellur-master-CHANGE_ME
WEBUI_SECRET_KEY=CHANGE_ME

# GPU workspace (set by `sudo vac gpu connect <host> <port>`). Empty = no inference backend.
GPU_SSH_HOST=
GPU_SSH_PORT=
GPU_SSH_USER=root
GPU_REMOTE_PORT=8000
# The --api-key given to vLLM on the GPU (generated by `sudo vac gpu init`).
VELLUR_GPU_API_KEY=
# Direct HTTPS endpoint instead of the tunnel (optional; e.g. another provider). Empty = use tunnel.
VELLUR_GPU_API_BASE=
VELLUR_EMBED_API_BASE=
